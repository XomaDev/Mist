var countries = ["India", "Japan", "Germany"]
Sys.println(countries.len())
Sys.println(countries.isEmpty())
countries.add("USA")
Sys.println(countries)
Sys.println(countries.contains("USA"))
Sys.println(countries.random())
Sys.println(countries.indexOf("Japan"))
Sys.println(countries.get(1))
countries.insert(1, "Saudi Arabia")
Sys.println(countries)
countries.set(3, "Morocco")
Sys.println(countries)
countries.remove(5)
Sys.println(countries)
Sys.println(countries.reverse())